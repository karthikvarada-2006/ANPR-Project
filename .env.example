# ==============================================================================
# City-Wide AI Engine for Multi-Camera ANPR Trajectory Tracking & Traffic Analytics
# Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and update the values to match your local setup.

# Database Configuration (PostgreSQL with PostGIS extension)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=city_anpr
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/city_anpr

# FastAPI Backend Settings
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True
API_RELOAD=True
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# City Road Network & Simulation Settings
SIM_CITY_NAME="Bengaluru, Karnataka, India"
SIM_NUM_CAMERAS=30
SIM_NUM_VEHICLES=100
SIM_TIME_STEP_SECONDS=1.0
SIM_RANDOM_SEED=42

# ANPR / OCR Settings
OCR_CONFIDENCE_THRESHOLD=0.75
DETECTION_CONFIDENCE_THRESHOLD=0.60
DEVICE=cpu  # 'cuda' or 'cpu'

# Alert Thresholds
SPEED_LIMIT_KMH=60.0
CONGESTION_SPEED_THRESHOLD_KMH=15.0
CONGESTION_DENSITY_THRESHOLD_VEH_PER_KM=80.0
